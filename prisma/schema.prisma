generator client {
  provider = "prisma-client"
  output   = "../backend/src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  age           Int?
  address       String?
  phone         String?
  birthDate     String?
  street        String?
  addressNumber String?
  city          String?
  state         String?
  country       String?
  email         String    @unique
  passwordHash  String
  passwordSalt  String?
  roleId        String?
  roleRef       Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  active        Boolean   @default(true)

  sessions      Session[]
  createdWines  Wine[]    @relation("WineCreator")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([roleId])
  @@index([email])
  @@map("usuario")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("role")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessao")
}

model Winery {
  id            String   @id @default(cuid())
  name          String
  cnpj          String   @unique
  city          String
  state         String
  email         String?
  walletAddress String?
  status        String   @default("Ativa")

  wines         Wine[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([status])
  @@map("vinicola")
}

model Wine {
  id String @id @default(cuid())

  createdById String?
  createdBy   User? @relation("WineCreator", fields: [createdById], references: [id], onDelete: SetNull)

  wineryId String?
  winery   Winery? @relation(fields: [wineryId], references: [id], onDelete: SetNull)

  typeId   String?
  wineType WineType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  name              String
  slug              String   @unique
  volumeMl          Int
  alcoholPercentage Float
  description       String   @db.Text

  characteristics String? @db.Text @map("caracteristicas")
  aromas          String? @db.Text @map("aromas")
  tastingNotes    String? @db.Text @map("notas_degustacao")
  pairing         String? @db.Text @map("harmonizacao")
  status    String @default("DRAFT")

  imageId String?    @unique @map("imagem_vinho_id")
  image   WineImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  vintages   Vintage[]
  batches    Batch[]
  grapeLinks WineGrape[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wineryId])
  @@index([typeId])
  @@index([createdById])
  @@index([status])
  @@index([name])
  @@map("vinho")
}

model WineType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  active      Boolean @default(true)

  wines Wine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("tipo_vinho")
}

model Grape {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  active      Boolean @default(true)

  wineLinks    WineGrape[]
  vintageLinks VintageGrape[]
  batchLinks   BatchGrape[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("uva")
}

model WineGrape {
  wineId  String
  grapeId String

  wine Wine @relation(fields: [wineId], references: [id], onDelete: Cascade)

  grape Grape @relation(fields: [grapeId], references: [id], onDelete: Cascade)

  @@id([wineId, grapeId])
  @@index([grapeId])
  @@map("vinho_uva")
}

model WineImage {
  id String @id @default(cuid())

  path      String
  altText   String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  wine Wine?

  @@index([isPrimary])
  @@map("imagem_vinho")
}

model Vintage {
  id String @id @default(cuid())

  wineId String?
  wine   Wine? @relation(fields: [wineId], references: [id], onDelete: SetNull)

  identifier   String @unique
  year         Int
  observations String?
  status       String

  supplier String?

  batches    Batch[]
  grapeLinks VintageGrape[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wineId])
  @@index([year])
  @@index([status])
  @@map("safra")
}

model VintageGrape {
  vintageId String
  grapeId   String

  vintage Vintage @relation(fields: [vintageId], references: [id], onDelete: Cascade)

  grape Grape @relation(fields: [grapeId], references: [id], onDelete: Cascade)

  @@id([vintageId, grapeId])
  @@index([grapeId])
  @@map("safra_uva")
}

model Batch {
  id String @id @default(cuid())

  wineId String?
  wine   Wine? @relation(fields: [wineId], references: [id], onDelete: SetNull)

  vintageId String
  vintage   Vintage @relation(fields: [vintageId], references: [id], onDelete: Restrict)

  code             String   @unique
  quantityLiters   Float
  productionDate   DateTime
  bottlingTime     String?  @map("hora_envase")
  registrationDate DateTime?

  status String

  blockchainRef String?
  qrCodePath    String?

  grapeLinks BatchGrape[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vintageId])
  @@index([wineId])
  @@index([status])
  @@index([productionDate])
  @@map("lote")
}

model BatchGrape {
  batchId String
  grapeId String

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  grape Grape @relation(fields: [grapeId], references: [id], onDelete: Cascade)

  @@id([batchId, grapeId])
  @@index([grapeId])
  @@map("lote_uva")
}
